{
  "schemaVersion": 1,
  "id": "user.duolingo",
  "name": "Duolingo",
  "version": "1.5.0",
  "author": "danielxxomg",
  "license": "MIT",
  "description": "Duolingo companion for Omarchy. Real-time daily streak monitor, multilingual progress breakdown, and smart evening streak reminders.",
  "homepage": "https://github.com/danielxxomg/omarchy-duolingo",
  "repository": "https://github.com/danielxxomg/omarchy-duolingo",
  "keywords": [
    "duolingo",
    "streak",
    "language",
    "education",
    "learning",
    "reminder"
  ],
  "kinds": [
    "bar-widget",
    "overlay",
    "service"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Overlay.qml",
    "service": "Service.qml"
  },
  "keepLoaded": false,
  "barWidget": {
    "displayName": "Duolingo",
    "description": "Daily streak indicator with course breakdown popup and background reminders",
    "category": "Education",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "username": "",
      "autoDetect": false,
      "refreshMinutes": 15,
      "showXp": false,
      "remindersEnabled": true,
      "remindHour": 20,
      "goalXp": 50,
      "reducedMotion": false
    },
    "schema": [
      {
        "key": "username",
        "type": "string",
        "label": "Duolingo Username (recommended; leave empty only if you enable the storage scan below)",
        "defaultValue": ""
      },
      {
        "key": "autoDetect",
        "type": "boolean",
        "label": "Scan local browser/Duolingo-app storage to find your username (OFF by default). Scans only Local Storage LevelDB folders of Duolingo Desktop, Brave, Chrome and Chromium; reads only the user.username field. See README Privacy section.",
        "defaultValue": false
      },
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "showXp",
        "type": "boolean",
        "label": "Show Total XP instead of streak on the bar",
        "defaultValue": false
      },
      {
        "key": "remindersEnabled",
        "type": "boolean",
        "label": "Evening reminder notifications",
        "defaultValue": true
      },
      {
        "key": "remindHour",
        "type": "integer",
        "label": "Reminder Hour (0-23)",
        "min": 0,
        "max": 23,
        "step": 1,
        "defaultValue": 20
      },
      {
        "key": "goalXp",
        "type": "integer",
        "label": "Daily XP goal (XP needed to complete today)",
        "min": 10,
        "max": 1000,
        "step": 10,
        "defaultValue": 50
      },
      {
        "key": "reducedMotion",
        "type": "boolean",
        "label": "Reduce motion (disable panel animations)",
        "defaultValue": false
      }
    ]
  }
}
